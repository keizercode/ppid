@{
    ViewData["Title"] = "Pendaftaran Berhasil";
    var no = ViewData["NoPermohonan"] as string ?? "";
}
<partial name="Partials/_PublicNavBar" />

<section class="section" style="padding-top:48px;padding-bottom:64px">
    <div class="section-inner" style="max-width:560px;margin:0 auto;text-align:center">
        <div style="font-size:48px;margin-bottom:16px">✅</div>
        <h1 style="font-size:1.5rem;font-weight:800;margin-bottom:8px">Permohonan Terdaftar</h1>
        <p style="color:#64748b;margin-bottom:20px;line-height:1.6">
            Data permohonan Anda telah masuk antrean Loket Kepegawaian.
            Simpan nomor permohonan berikut untuk melacak status.
        </p>
        @if (!string.IsNullOrEmpty(no))
        {
            <p style="font-family:monospace;font-size:1.1rem;font-weight:700;background:#f0fdf4;border:1px solid #bbf7d0;padding:12px 20px;border-radius:12px;margin-bottom:24px">@no</p>
        }
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
            <a href="/#lacak" class="btn-primary" style="display:inline-flex;padding:10px 20px;border-radius:10px;background:#002d7a;color:white;font-weight:600;text-decoration:none">Lacak Status</a>
            <a href="/" style="display:inline-flex;padding:10px 20px;border-radius:10px;border:1px solid #e2e8f0;color:#475569;font-weight:600;text-decoration:none">Kembali ke Beranda</a>
        </div>
        <p style="font-size:12px;color:#94a3b8;margin-top:24px">
            Tahap selanjutnya: datang ke Loket Kepegawaian untuk identifikasi awal dan tanda tangan formulir,
            atau tunggu konfirmasi dari petugas loket.
        </p>
    </div>
</section>

<link rel="stylesheet" href="~/css/home.css" />
